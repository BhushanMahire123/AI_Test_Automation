<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="TutorialsNinja-Suite"
       parallel="false"
       thread-count="1"
       verbose="1">

    <listeners>
        <listener class-name="com.tutorialsninja.utils.report.ReportFlushListener"/>
    </listeners>

    <test name="TutorialsNinja-Regression">
        <classes>
            <class name="com.tutorialsninja.runners.SmokeTestRunner"/>
        </classes>
    </test>

</suite>
